model_training/sources/books/*
!model_training/sources/books/README.md
model_training/sources/v002_recovery/*
!model_training/sources/v002_recovery/README.md
# Permanent ticket/trade JSONL archive (local training store; README tracked)
model_training/tick_data/*
!model_training/tick_data/README.md

# Packaged skill exports at repo root (use TRADING_KNOWLEDGE_BASE.md instead)
/knowledge/

# Temp / helper files
