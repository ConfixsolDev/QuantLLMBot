__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime output
logs/
*.log

# Local virtual environments and editor state
.venv/
.venvs/
venv/
.codex_deps/
.agents/
.idea/
.vscode/

# Large vendor / research data (never commit)
MT5Tester/
Backtests/
Books/
EA/
output/
RandDData/
tmp/

# Recoverable local quarantine; retired files are removed from active source.
/remove/

# Other packaged dumps (regenerated; not source). QuantLLMBot_training.zip is
# tracked so Colab/v004 weekly trains can pull the frozen curriculum bundle.
*.training.zip

# Store runtime ledgers (local only — not loaded by live Qwen app)
store/episodes.jsonl
store/audit_log.jsonl
store/_quarantine/
# Memory JSON — tracked in git when present
!store/knowledge_cards.json
!store/principles_registry.json
!store/review_queue.json
!store/run_state.json

# Model training large artifacts (keep scripts + docs in git)
model_training/adapters/
model_training/exports/
model_training/outputs/
model_training/datasets/*
!model_training/datasets/README.md
model_training/sources/books/*
!model_training/sources/books/README.md
model_training/sources/v002_recovery/*
!model_training/sources/v002_recovery/README.md
# Permanent ticket/trade JSONL archive (local training store; README tracked)
model_training/tick_data/*
!model_training/tick_data/README.md

# Packaged skill exports at repo root (use TRADING_KNOWLEDGE_BASE.md instead)
/knowledge/

# Temp / helper files
_tracked_files.txt
