apps/qwen_trade_software/backend/model-residency.json
apps/qwen_trade_software/backend/_tmp_*.py

# Plan View (Next.js) — source in repo; deps and build output local only
apps/qwen_trade_software/planview/node_modules/
apps/qwen_trade_software/planview/.next/
apps/qwen_trade_software/planview/out/
apps/qwen_trade_software/planview/tsconfig.tsbuildinfo
apps/qwen_trade_software/desk/tsconfig.tsbuildinfo

# Other packaged dumps (regenerated; not source). QuantLLMBot_training.zip is
# tracked so Colab/v004 weekly trains can pull the frozen curriculum bundle.
*.training.zip

# Legacy research paths (removed from tree; keep ignored if restored locally)
ResearchLab/store/
ResearchLab/model_training/
ResearchLab/TempFiles/
ResearchLab/config.json
ResearchLab/output/

# Store runtime ledgers (local only — not loaded by live Qwen app)
store/episodes.jsonl
store/audit_log.jsonl
store/_quarantine/
# Memory JSON — tracked in git when present
!store/knowledge_cards.json
!store/principles_registry.json
!store/review_queue.json
!store/run_state.json

# Model training large artifacts (keep scripts + docs in git)
model_training/adapters/
model_training/exports/
